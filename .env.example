# padlok-api admin/dashboard backend (defaults to port 4000)
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_APP_NAME=PadLok Admin
VITE_CLIENT_SERVER_URL=http://localhost:5000/api/v1

# padlokbackend's base URL (the consumer-facing backend, NOT padlok-api,
# and NOT the same port as VITE_API_URL above) — it is the only service
# running a Socket.IO server. The dispute chat panel connects directly here
# with a short-lived ticket minted by padlok-api
# (POST /escrow/disputes/:id/chat/ticket). Production default matches
# padlok-api's own USER_BACKEND_URL (see padlok-api/src/config/env.ts):
# https://server.padlokit.com. Defaults to padlokbackend's own default PORT
# (see padlokbackend/src/server.ts) for local dev — override to match
# wherever your local padlokbackend instance is actually listening.
VITE_DISPUTE_CHAT_SOCKET_URL=http://localhost:6000
